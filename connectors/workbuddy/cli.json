{
  "runtime": {
    "type": "node",
    "version": "20"
  },
  "init": {
    "darwin": "npm install -g szu-cli@0.2.15",
    "linux": "npm install -g szu-cli@0.2.15",
    "win32": "npm install -g szu-cli@0.2.15"
  },
  "auth": {
    "darwin": "szu-cli auth login --workbuddy",
    "linux": "szu-cli auth login --workbuddy",
    "win32": "szu-cli.cmd auth login --workbuddy"
  },
  "unAuth": {
    "darwin": "szu-cli auth logout",
    "linux": "szu-cli auth logout",
    "win32": "szu-cli.cmd auth logout"
  },
  "status": {
    "darwin": "szu-cli auth status",
    "linux": "szu-cli auth status",
    "win32": "szu-cli.cmd auth status"
  },
  "statusMatch": "\"loggedIn\"\\s*:\\s*true",
  "authWaitForExit": true,
  "authSuppressBrowser": true,
  "authUrlDomain": "szu.edu.cn"
}
