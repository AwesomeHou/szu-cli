{
  "ruleset": "l0-v1",
  "outcome": "success",
  "commands": {
    "required": [
      {
        "rule": "library.command-search",
        "argvPrefix": ["szu-cli", "library", "search"],
        "argvContains": ["交通设计"],
        "min": 1,
        "max": 1
      },
      {
        "rule": "library.command-item",
        "argvPrefix": ["szu-cli", "library", "item"],
        "min": 1,
        "max": 1
      }
    ],
    "sequences": [
      {
        "rule": "library.search-before-item",
        "steps": [
          { "argvPrefix": ["szu-cli", "library", "search"] },
          { "argvPrefix": ["szu-cli", "library", "item"] }
        ]
      }
    ],
    "allowedPreflight": [
      ["node", "--version"],
      ["szu-cli", "--version"],
      ["szu-cli", "doctor"],
      ["szu-cli", "auth", "status"]
    ],
    "forbidden": []
  },
  "result": {
    "requiredMetaCommand": "library item",
    "requiredPaths": ["data.copies[].location", "data.copies[].callNumber", "data.copies[].status"],
    "forbiddenTokens": ["2023000000", "测试用户", "cookies", "session"]
  },
  "final": {
    "mustMention": ["南馆5楼工科阅览室", "U491/L73", "可供出借"]
  },
  "rules": [
    "trace.uses-szu-cli",
    "trace.no-direct-scraping",
    "trace.no-mcp",
    "trace.result-json",
    "trace.exit-code",
    "trace.no-secret",
    "trace.no-unneeded-identity",
    "final.evidence-backed",
    "result.meta-command",
    "result.required-paths",
    "final.must-mention",
    "library.command-search",
    "library.command-item",
    "library.search-before-item"
  ]
}
