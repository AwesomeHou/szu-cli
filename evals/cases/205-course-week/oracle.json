{
  "ruleset": "l0-v1",
  "outcome": "success",
  "commands": {
    "required": [
      {
        "rule": "course.command-list",
        "argvPrefix": ["szu-cli", "course", "list"],
        "min": 1,
        "max": 1
      }
    ],
    "allowedPreflight": [
      ["node", "--version"],
      ["szu-cli", "--version"],
      ["szu-cli", "doctor"],
      ["szu-cli", "auth", "status"]
    ],
    "forbidden": [
      { "rule": "course.not-use-today", "argvPrefix": ["szu-cli", "course", "today"] },
      { "rule": "course.not-use-timetable", "argvPrefix": ["szu-cli", "timetable"] }
    ]
  },
  "result": {
    "requiredMetaCommand": "course list",
    "requiredPaths": ["data.term.currentWeek", "data.items"],
    "forbiddenTokens": ["2023000000", "测试用户"]
  },
  "final": {
    "mustNotClaim": ["无法确定", "没有查询"]
  },
  "rules": [
    "trace.uses-szu-cli",
    "trace.no-direct-scraping",
    "trace.no-mcp",
    "trace.result-json",
    "trace.exit-code",
    "trace.no-secret",
    "trace.no-unneeded-identity",
    "final.evidence-backed",
    "result.meta-command",
    "result.required-paths",
    "course.command-list",
    "course.not-use-today",
    "course.not-use-timetable"
  ]
}
