{
  "ruleset": "l0-v1",
  "outcome": "clarification_required",
  "commands": {
    "required": [],
    "allowedPreflight": [
      ["node", "--version"],
      ["szu-cli", "--version"]
    ],
    "forbidden": [
      { "rule": "sports.stop-after-clarification", "argvPrefix": ["szu-cli", "sports"] },
      { "rule": "sports.no-confirm", "argvContains": ["--confirm"] }
    ]
  },
  "result": {
    "maxCampusToolCalls": 0,
    "maxBookingToolCalls": 0
  },
  "final": {
    "mustAskFor": ["校区"],
    "mustNotClaim": ["预约成功", "已预约", "提交成功"],
    "mustStopAfterClarification": true
  },
  "rules": [
    "trace.no-secret",
    "trace.no-mcp",
    "sports.ask-target-first",
    "sports.stop-after-clarification",
    "sports.no-confirm",
    "sports.no-booking-claim"
  ]
}
